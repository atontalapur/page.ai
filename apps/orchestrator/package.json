{
  "name": "@page/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Nest app: ingest, triage, issue state machine, job queues, serves the UI",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --env-file-if-exists=../../.env --enable-source-maps dist/apps/orchestrator/src/main.js",
    "start": "node --enable-source-maps dist/apps/orchestrator/src/main.js",
    "page:test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env scripts/test-page.ts",
    "dashboard-token": "node scripts/dashboard-token.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/testing": "^12.5.0",
    "@page/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/websockets": "^12.6.0",
    "@page/contracts": "workspace:*",
    "@page/db-migrations": "workspace:*",
    "@page/model-client": "workspace:*",
    "fastify": "5.12.8",
    "kysely": "^0.29.9",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "catalog:",
    "zod": "catalog:"
  }
}
