{
  "name": "@page/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Nest app: ingest, triage, issue state machine, job queues, serves the UI",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && node --env-file-if-exists=../../.env --enable-source-maps dist/apps/orchestrator/src/main.js",
    "start": "node --enable-source-maps dist/apps/orchestrator/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@nestjs/testing": "^12.3.3",
    "@page/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "@page/contracts": "workspace:*",
    "@page/db-migrations": "workspace:*",
    "kysely": "^0.29.8",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  }
}
