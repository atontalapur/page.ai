# Copy to .env. Uses the root docker-compose Postgres; `pnpm db:migrate` creates the
# `demo` database on first run so the demo app's tables stay apart from the orchestrator's.
DATABASE_URL=postgres://page:page@localhost:5432/demo

# Shop settings (optional; defaults shown). Left unset so the app runs on its defaults,
# like staging does.
# SHIPPING_FLAT_CENTS=500
# FREE_SHIPPING_MIN_CENTS=5000
# MAX_ITEM_QUANTITY=10
# CHECKOUT_ENABLED=true

# Error reporting (#2). Leave POSTHOG_KEY unset locally and in tests: errors then go to an
# in-memory fake and nothing is sent. Staging sets it to the PostHog project API key.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
