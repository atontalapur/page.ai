{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/demo-app/Dockerfile",
    "watchPatterns": [
      "apps/demo-app/**",
      "packages/config/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "/package.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "preDeployCommand": "node scripts/db.ts migrate && node scripts/db.ts seed",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ALWAYS"
  }
}
