{
  "name": "@page/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas between apps and packages",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures": {
      "types": "./src/__fixtures__/index.ts",
      "default": "./src/__fixtures__/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@page/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
