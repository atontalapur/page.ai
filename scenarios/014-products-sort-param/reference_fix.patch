+// Sort keys and the column each one orders by. Only these columns ever reach the SQL.
+const sortColumns = { name: 'name', price: 'price_cents', stock: 'stock' } as const;
+export type ProductSort = keyof typeof sortColumns;
+
+export function isProductSort(value: string): value is ProductSort {
+  return Object.hasOwn(sortColumns, value);
+}
+
+/** Lists the catalogue ordered by `sort` (name by default). */
+export async function listProducts(db: Queryable, sort: ProductSort = 'name'): Promise<Product[]> {
+  if (!isProductSort(sort)) throw new Error(`Unknown product sort ${String(sort)}`);
+  const { rows } = await db.query<Product>(
+    `select ${columns} from products order by ${sortColumns[sort]}`,
+  );
   return rows;
 }
 
