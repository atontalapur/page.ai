# Copy to .env, or run `pnpm env:pull` for the shared secrets (docs/env-sync.md).
# The Postgres values match the local Postgres in docker-compose.yml.
# Change both together if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://page:page@localhost:5432/page
# Host port for the demo app container (`docker compose up`).
DEMO_APP_PORT=3000

# Node daemon (apps/node). `pnpm --filter @page/node start` reads this file as ../../.env.
# The full list and defaults are in apps/node/README.md.
# The orchestrator listens on PORT (default 4000, so the demo app keeps 3000 locally).
ORCHESTRATOR_URL=http://localhost:4000
NODE_SHARED_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tier 2 host tools (#10): a fine-grained token for the demo repo only, with Contents and
# Pull requests read and write. Setup is in docs/demo-repo.md.
GITHUB_TOKEN=
GITHUB_REPO=atontalapur/page-demo
# Node daemon: true swaps Docker, OpenRouter, GitHub and the orchestrator socket for fakes.
# The orchestrator uses it for OpenRouter triage and Twilio. false still boots on DATABASE_URL
# alone: triage uses rules and pages are recorded.
USE_FAKE_ADAPTERS=false
# PostHog sends this as `Authorization: Bearer <secret>` to POST /ingest/posthog.
POSTHOG_WEBHOOK_SECRET=
# Twilio. Set all three together. NOTIFY_TO_NUMBERS is comma-separated E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_NUMBERS=
# Link in the call and the SMS. The issue id is appended.
DASHBOARD_URL=http://localhost:3000
# Cheap triage model. Blank uses openai/gpt-4o-mini.
# TRIAGE_MODEL=
# TRIAGE_TIMEOUT_MS=8000
