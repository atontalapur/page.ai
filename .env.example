# Copy to .env, or run `pnpm env:pull` for the shared secrets (docs/env-sync.md).
# The Postgres values match the local Postgres in docker-compose.yml.
# Change both together if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://page:page@localhost:5432/page
# Host port for the demo app container (`docker compose up`).
DEMO_APP_PORT=3000

# Node daemon (apps/node). `pnpm --filter @page/node start` reads this file as ../../.env.
# The full list and defaults are in apps/node/README.md.
# The orchestrator listens on PORT (default 4000, so the demo app keeps 3000 locally).
ORCHESTRATOR_URL=http://localhost:4000
# The daemon sends it as `auth.token` on the orchestrator's /node socket, and the orchestrator
# refuses a daemon without it. Both read this one var. Blank on the orchestrator refuses every
# daemon. Shared through `pnpm env:pull`.
NODE_SHARED_SECRET=
# What the UI's agents page calls this daemon, sent in the same handshake. Letters, digits,
# dots, underscores and hyphens. Blank uses the hostname.
# NODE_NAME=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tier 2 host tools (#10): a fine-grained token for the demo repo only, with Contents and
# Pull requests read and write. Setup is in docs/demo-repo.md.
GITHUB_TOKEN=
GITHUB_REPO=atontalapur/page-demo
# Node daemon, Tier 3 ops tools (#155): the demo app its Tier 3 runs may reconfigure and
# restart. Blank gives them no ops tools. It needs that app's OPS_SECRET (below). https,
# or http for localhost only. Point a local daemon at the compose app
# (http://localhost:3000), not staging.
OPS_APP_URL=
# The demo app's ops API secret, 32+ characters. docker compose gives it to the local demo
# app; the daemon (with OPS_APP_URL), the eval and `pnpm e2e` send it.
OPS_SECRET=
# Node daemon, Tier 3 rollback tool: the Railway service that serves OPS_APP_URL, which
# Tier 3 runs may roll back. Set all four with OPS_APP_URL, or none; blank gives them no
# rollback tool. The token is a project token for that service's environment. The ids are
# UUIDs from the service's dashboard URL. Not RAILWAY_TOKEN or RAILWAY_*_ID: Railway sets
# those on every service it runs, the daemon's own included. Never point a local daemon
# at staging's service.
OPS_RAILWAY_TOKEN=
OPS_RAILWAY_PROJECT_ID=
OPS_RAILWAY_ENVIRONMENT_ID=
OPS_RAILWAY_SERVICE_ID=
# Node daemon: true swaps Docker, OpenRouter, GitHub and the orchestrator socket for fakes.
# The orchestrator uses it for OpenRouter triage and Twilio. false still boots on DATABASE_URL
# alone: triage uses rules and pages are recorded.
USE_FAKE_ADAPTERS=false
# Orchestrator API: `Authorization: Bearer <token>` on every route but /health and /ingest.
# Blank returns 401 on all of them. Shared through `pnpm env:pull`.
ORCHESTRATOR_API_TOKEN=
# PostHog sends this as `Authorization: Bearer <secret>` to POST /ingest/posthog.
POSTHOG_WEBHOOK_SECRET=
# Demo app error reporting (#2, #126). Blank POSTHOG_KEY sends nothing. The key is shared
# through `pnpm env:pull`. docker compose passes both to the demo app build and server.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Twilio. Set all three together. NOTIFY_TO_NUMBERS is comma-separated E.164.
# Setup and the page:test check are in docs/twilio.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Voicemail picking up counts as not answered, so the call retries. Paid accounts only:
# a trial account rejects it and every call fails.
# TWILIO_MACHINE_DETECTION=false
# A trial account only takes Twilio's call and SMS templates. true sends those instead of the
# page text; the phone still rings and gets a text. See docs/twilio.md.
# TWILIO_TRIAL=false
NOTIFY_TO_NUMBERS=
# Where the orchestrator serves the UI. The call and the SMS link <url>/incidents/<id>.
DASHBOARD_URL=http://localhost:4000
# Cheap triage model. Blank uses openai/gpt-4o-mini.
# TRIAGE_MODEL=
# TRIAGE_TIMEOUT_MS=8000
# Start a Tier 1 fix right after triage. Off unless set; each run spends model budget.
# AUTO_START_FIX=true
# Fix starts allowed per rolling hour, manual ones counted, before triage stops starting
# them and leaves issues for an operator. Anyone with the public PostHog key can send an
# error whose report becomes the agent's task, so this bounds forged starts. Each start can
# still escalate through all three tiers, and forged errors can use up the cap so real ones
# wait for an operator.
# AUTO_START_FIX_MAX_PER_HOUR=5
